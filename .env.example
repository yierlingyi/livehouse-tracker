# ============================================================
# Band Live API — 环境变量示例（backend/config.py 读取的全部变量）
# 使用：复制为 .env 并按需修改，勿直接改本文件。
#   cp .env.example .env
# 所有敏感值（数据库密码 / token 密钥）只从环境变量读取，禁止硬编码。
# 启动脚本 scripts/run.sh 会自动 source .env。
# ============================================================

# ---- 数据库（必填）----
# Primary 数据库连接串（asyncpg DSN 格式）。必填。
# 格式：postgresql://用户名:密码@主机:端口/库名
DATABASE_URL_PRIMARY=postgresql://app_user:change_me_strong_password@127.0.0.1:5432/app_db

# Replica 数据库连接串。可选；留空则 replica 读回退 Primary。
DATABASE_URL_REPLICA=

# 连接池下限 / 上限（默认 5 / 50）。max 必须 >= min。
DB_POOL_MIN=5
DB_POOL_MAX=50

# ---- 安全（必填）----
# HMAC-SHA256 签名密钥，用于分页 token 与认证 token。必填。
# 生产环境请用足够长的随机串，生成示例：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
TOKEN_SECRET=please_change_me_to_a_long_random_secret

# 分页 token 有效期（分钟，默认 30）。
TOKEN_TTL_MINUTES=30

# ---- Redis（可选）----
# Redis 连接串；留空则缓存 / 限流走内存降级（不持久、不跨实例）。
# 格式：redis://[:密码@]主机:端口/库号，例如 redis://127.0.0.1:6379/0
REDIS_URL=

# /full 缓存 TTL 基准（秒，默认 60）与随机抖动（秒，默认 30），避免集中失效。
CACHE_TTL_BASE=60
CACHE_TTL_JITTER=30

# ---- 限流 ----
# /full 与 /sync 每分钟配额（默认 30 / 60）。
RATE_LIMIT_FULL_PER_MINUTE=30
RATE_LIMIT_SYNC_PER_MINUTE=60

# ---- 业务 ----
# /full 固定 scope 长度（天，默认 90）。
SCOPE_DEFAULT_DAYS=90

# CDC 日志保留天数（默认 30）。
RETENTION_DAYS=30

# ---- 文件上传 ----
# 上传文件落盘目录（相对仓库根或绝对路径，默认 uploads）。
UPLOAD_DIR=uploads

# 上传文件对外 URL 前缀（默认 /static/uploads）。
UPLOAD_URL_PREFIX=/static/uploads
