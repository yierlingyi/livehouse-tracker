# ---- Node / 构建产物 ----
node_modules/
unpackage/
前端/unpackage/
前端/*/unpackage/
前端/package-lock.json

# ---- 生成目录：三端 common/ 由 sync-shared 脚本从 shared/ 生成，禁止直接改/提交 ----
前端/user-app/common/
前端/band-portal/common/
前端/admin-console/common/

# ---- Python ----
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/

# ---- 环境变量（含数据库密码 / token 密钥，禁止提交）----
.env
.env.local
.env.*.local

# ---- 运行时上传目录（backend UPLOAD_DIR，默认 uploads/）----
uploads/

# ---- 编辑器 / 系统 ----
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

